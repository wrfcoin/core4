# WRFCoin E2E Testing Environment Configuration (Example)

# Test Environment
NODE_ENV=test
E2E_ENV=playwright

# Base URL Configuration
BASE_URL=http://localhost:5001

# WRFCoin Service Endpoints
MAIN_API_URL=http://localhost:4001
CROSS_CHAIN_URL=http://localhost:3000
WALLET_SERVER_URL=http://localhost:4000
COMPUTE_NETWORKS_URL=http://localhost:6000
AI_ML_NETWORKS_URL=http://localhost:6001
STORAGE_NETWORKS_URL=http://localhost:7000
IOT_SENSOR_NETWORKS_URL=http://localhost:3002
GOVERNANCE_SERVER_URL=http://localhost:8000
WEATHER_EARNINGS_URL=http://localhost:8080
NODE_DISCOVERY_URL=http://localhost:9001

# Database URLs
DATABASE_URL=postgresql://postgres:testpass@localhost:5432/wrfcoin_test
REDIS_URL=redis://localhost:6379

# Blockchain Configuration
BLOCKCHAIN_NODE_URL=http://localhost:8545
NETWORK_ID=31337

# Test Configuration
PLAYWRIGHT_WORKERS=1
PLAYWRIGHT_TIMEOUT=60000
HEADLESS=true

# API Keys (Test/Mock)
TEST_WEATHER_API_KEY=<REPLACE_test_weather_api_key>
TEST_BLOCKCHAIN_API_KEY=<REPLACE_test_blockchain_api_key>

# Security (Test values only)
JWT_SECRET=<generate_test_jwt_secret_min_32_chars>
HSM_ENDPOINT=http://localhost:8200
HSM_KEY_ID=<REPLACE_test_hsm_key_id>

# Storage — allow unencrypted for test environments
ALLOW_UNENCRYPTED_STORAGE=true

# Performance Testing
LOAD_TEST_USERS=10
LOAD_TEST_DURATION=60s

# Feature Flags for E2E Testing
ENABLE_CARBON_CREDITS=true
ENABLE_NFT_MARKETPLACE=true
ENABLE_DEFI_OPERATIONS=true
ENABLE_GOVERNANCE=true
ENABLE_CROSS_CHAIN_BRIDGE=true
ENABLE_WEATHER_INTEGRATION=true
ENABLE_COMPUTATIONAL_JOBS=true
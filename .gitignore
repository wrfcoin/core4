# ===========================================
# DEPRECATED LEGACY ROOT DIRECTORIES
# ===========================================
# These directories should not exist at root level anymore
# Files should be moved to appropriate standardized locations:
# - Backend code → backend/
# - Smart contracts → contracts/
# - Tests → tests/
# - Documentation → docs/
# - Infrastructure → infra/

# Legacy test directories (consolidate to tests/)
/test-archive/
/fuzz-testing/
/consolidated-tests/
/test-results/

# Legacy documentation files (move to docs/)
# Note: Allow existing files but prevent new legacy structure
/legacy-docs/
/old-docs/

# Legacy infrastructure (move to infra/)
/infrastructure/
/deployment/
/k8s/
/terraform/
/helm/

# Legacy asset directories (organize appropriately)
/assets/*/
/static/*/
/public/*/

# Legacy temporary directories
/temp/
/temporary/
/scratch/
/working/

# Legacy backup directories
/backup/
/backups/
/old/
/archive-*/

# Prevent creation of new top-level source directories
# (enforce standardized structure)
/api/
/services/
/workers/
/lib/
/libs/
/utils-*/
/helpers/
/middleware-*/
/models/
/controllers/
/routes-*/


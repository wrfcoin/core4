# Wrfcoin Environment Variables Template
# Copy this file to .env and replace with your actual values

# ==============================================
# REQUIRED SECRETS - Must be set before startup
# ==============================================

# JWT Authentication (minimum 32 characters)
JWT_SECRET=<generate_secure_random_min_32_chars>

# Session Management (minimum 32 characters)  
SESSION_SECRET=<generate_secure_random_min_32_chars>

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/wrfcoin
POSTGRES_PASSWORD=<REPLACE_your_secure_database_password>

# ==============================================
# OPTIONAL SECRETS - For enhanced functionality
# ==============================================

# IPFS/Pinata Integration
PINATA_API_KEY=<your_pinata_api_key>
PINATA_SECRET_KEY=<your_pinata_secret_key>

# External APIs
SONM_API_KEY=<your_sonm_api_key>

# Redis Cache (if using)
REDIS_URL=redis://localhost:6379

# HashiCorp Vault Configuration
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=<generate_dev_vault_token>
VAULT_AUTH_METHOD=token
VAULT_NAMESPACE=wrfcoin
VAULT_MOUNT_PATH=secret
VAULT_SKIP_VERIFY=true
VAULT_MAX_RETRIES=3
VAULT_TIMEOUT=30000

# Vault Server Configuration
VAULT_SERVER_PORT=8300

# For AppRole authentication (production)
# VAULT_ROLE_ID=<your_vault_role_id>
# VAULT_SECRET_ID=<your_vault_secret_id>

# For Kubernetes authentication
# VAULT_K8S_ROLE=wrfcoin-app

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Security Settings
HTTPS_ENABLED=false
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/wrfcoin.log

# ==============================================
# BLOCKCHAIN CONFIGURATION
# ==============================================

# Environment
WRFCOIN_ENV=development
BLOCKCHAIN_NETWORK=testnet

# ==============================================
# RPC ENDPOINTS (Per-Chain Configuration)
# ==============================================

# Ethereum
ETHEREUM_RPC_PRIMARY=http://localhost:8545
ETHEREUM_RPC_FALLBACK=
ETHEREUM_GOERLI_RPC=

# Polygon
POLYGON_RPC_PRIMARY=
POLYGON_RPC_FALLBACK=
POLYGON_MUMBAI_RPC=

# BSC
BSC_RPC_PRIMARY=
BSC_TESTNET_RPC=

# Avalanche
AVALANCHE_RPC_PRIMARY=
AVALANCHE_FUJI_RPC=

# Arbitrum
ARBITRUM_RPC_PRIMARY=
ARBITRUM_GOERLI_RPC=

# Optimism
OPTIMISM_RPC_PRIMARY=
OPTIMISM_GOERLI_RPC=

# Base
BASE_RPC_PRIMARY=
BASE_GOERLI_RPC=

# Fantom
FANTOM_RPC_PRIMARY=
FANTOM_TESTNET_RPC=

# Solana
SOLANA_RPC_PRIMARY=
SOLANA_TESTNET_RPC=

# Cosmos/IBC
COSMOS_RPC_PRIMARY=
COSMOS_TESTNET_RPC=
OSMOSIS_RPC_PRIMARY=

# Polkadot/Kusama
POLKADOT_RPC_PRIMARY=
KUSAMA_RPC_PRIMARY=

# API Keys for RPC Providers
INFURA_PROJECT_ID=
ALCHEMY_API_KEY=

# ==============================================
# WALLET CONFIGURATION
# ==============================================

# Wallet Configuration
WALLET_ENCRYPTION_ENABLED=true
HSM_ENABLED=false

# ==============================================
# DEVELOPMENT ONLY
# ==============================================

# Auth fail-fast bypass (development only) — skip token check on startup
# WRFCOIN_ALLOW_NO_AUTH=1

# Allow running without storage encryption in development (see issue #1027)
ALLOW_UNENCRYPTED_STORAGE=true

# Debug Settings (development only)
DEBUG=false
VERBOSE_LOGGING=false

# Mock Data (development only)
USE_MOCK_DATA=false
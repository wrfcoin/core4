# WRFCoin Staging Environment Variables
# Copy to .env and replace with actual values

# ==============================================
# ENVIRONMENT IDENTIFICATION
# ==============================================
NODE_ENV=production
WRFCOIN_ENV=staging

# ==============================================
# REQUIRED SECRETS
# ==============================================

# JWT Authentication (use strong random value)
JWT_SECRET=<generate_secure_32+_char_secret>

# Session Management (use strong random value)
SESSION_SECRET=<generate_secure_32+_char_secret>

# Database Configuration (use staging database)
DATABASE_URL=postgresql://wrfcoin:${POSTGRES_PASSWORD}@postgres-staging:5432/wrfcoin_staging
POSTGRES_PASSWORD=<staging_database_password>

# ==============================================
# INFRASTRUCTURE
# ==============================================

# Redis Configuration
REDIS_URL=redis://redis-staging:6379

# Server Configuration
PORT=4001
HOST=0.0.0.0

# ==============================================
# SECURITY
# ==============================================

# HTTPS (should be enabled via reverse proxy)
HTTPS_ENABLED=true

# CORS (staging frontend URL)
CORS_ORIGIN=https://staging.wrfcoin.io

# ==============================================
# VAULT CONFIGURATION
# ==============================================

# HashiCorp Vault
VAULT_ADDR=https://vault-staging.wrfcoin.io
VAULT_NAMESPACE=wrfcoin/staging
VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=<staging_role_id>
VAULT_SECRET_ID=<staging_secret_id>
VAULT_MOUNT_PATH=secret
VAULT_SKIP_VERIFY=false
VAULT_MAX_RETRIES=3
VAULT_TIMEOUT=30000

# ==============================================
# BLOCKCHAIN
# ==============================================

# Network Configuration
BLOCKCHAIN_NETWORK=testnet

# RPC Endpoints (use environment variables, not hardcoded)
ETHEREUM_RPC_PRIMARY=https://goerli.infura.io/v3/${INFURA_PROJECT_ID}
ETHEREUM_RPC_FALLBACK=https://eth-goerli.g.alchemy.com/v2/${ALCHEMY_API_KEY}
POLYGON_RPC_PRIMARY=https://rpc-mumbai.maticvigil.com
BSC_RPC_PRIMARY=https://data-seed-prebsc-1-s1.binance.org:8545

# Storage Encryption (Required — node will refuse to start without this)
# Generate: openssl rand -hex 32
WRFCOIN_STORAGE_ENCRYPTION_KEY=<REPLACE_openssl_rand_hex_32>

# Wallet Configuration
WALLET_ENCRYPTION_ENABLED=true
HSM_ENABLED=false

# ==============================================
# EXTERNAL SERVICES
# ==============================================

# IPFS/Pinata
PINATA_API_KEY=<staging_pinata_key>
PINATA_SECRET_KEY=<staging_pinata_secret>

# API Keys
INFURA_PROJECT_ID=<staging_infura_id>
ALCHEMY_API_KEY=<staging_alchemy_key>

# ==============================================
# MONITORING
# ==============================================

# Logging
LOG_LEVEL=info
LOG_FILE=logs/wrfcoin-staging.log

# Metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Tracing
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://jaeger-staging:14268/api/traces

# ==============================================
# IOT SENSORS
# ==============================================

# AcuRite (use environment variables)
ACURITE_DEVICE_ID=<staging_device_id>
ACURITE_LOCAL_IP=<staging_local_ip>

# ==============================================
# STAGING-SPECIFIC
# ==============================================

# Debug (keep disabled in staging)
DEBUG=false
VERBOSE_LOGGING=false
USE_MOCK_DATA=false

# WRFCoin Production Environment Variables
# CRITICAL: This file is a template only. Never commit actual secrets.
# Copy to .env and configure via secure secret management (Vault/K8s Secrets)

# ==============================================
# ENVIRONMENT IDENTIFICATION
# ==============================================
NODE_ENV=production
WRFCOIN_ENV=production

# ==============================================
# REQUIRED SECRETS
# IMPORTANT: These should be injected from Vault/K8s Secrets
# ==============================================

# JWT Authentication (minimum 64 characters for production)
JWT_SECRET=<inject_from_vault>

# Session Management (minimum 64 characters for production)
SESSION_SECRET=<inject_from_vault>

# Database Configuration (use read replicas for production)
DATABASE_URL=postgresql://wrfcoin:${POSTGRES_PASSWORD}@postgres-primary:5432/wrfcoin_production
DATABASE_READ_REPLICA_URL=postgresql://wrfcoin_read:${POSTGRES_READ_PASSWORD}@postgres-replica:5432/wrfcoin_production
POSTGRES_PASSWORD=<inject_from_vault>
POSTGRES_READ_PASSWORD=<inject_from_vault>

# ==============================================
# INFRASTRUCTURE
# ==============================================

# Redis Cluster
REDIS_URL=rediss://redis-cluster:6379
REDIS_PASSWORD=<inject_from_vault>
REDIS_TLS_ENABLED=true

# Server Configuration
PORT=4001
HOST=0.0.0.0

# ==============================================
# SERVICE DISCOVERY
# ==============================================

# Internal service URLs (use K8s service names or Docker service names in production)
BLOCKCHAIN_SERVICE_URL=http://wrfcoin-blockchain:4000
BLOCKCHAIN_RPC_URL=http://wrfcoin-blockchain:8545
BLOCK_EXPLORER_URL=https://explorer.wrfcoin.io
API_BASE_URL=https://api.wrfcoin.io
FRONTEND_URL=https://app.wrfcoin.io

# Microservice URLs
NFT_SERVICE_URL=http://nft-service:4002
USER_SERVICE_URL=http://user-service:4003
MAIN_SERVICE_URL=http://main-api:4001
RUST_BLOCKCHAIN_URL=http://wrfcoin-blockchain:8000
N8N_URL=http://n8n:5678

# Storage service URLs
IPFS_ENDPOINT=http://ipfs-node:5001
IPFS_GATEWAY=http://ipfs-gateway:8080
SWARM_ENDPOINT=http://swarm-node:8500
VAULT_ENDPOINT=https://vault.wrfcoin.io

# Weather & IoT
WEATHER_CONNECTOR_URL=http://weather-connector:4200

# Observability
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics

# WebAuthn
WEBAUTHN_RP_ID=wrfcoin.io
WEBAUTHN_ORIGIN=https://app.wrfcoin.io

# ==============================================
# SECURITY (CRITICAL)
# ==============================================

# HTTPS (enforced via load balancer)
HTTPS_ENABLED=true
HSTS_ENABLED=true

# CORS (production domains only)
CORS_ORIGIN=https://wrfcoin.io,https://app.wrfcoin.io

# HSM Required in Production
HSM_ENABLED=true

# ==============================================
# VAULT CONFIGURATION (PRODUCTION)
# ==============================================

# HashiCorp Vault - Production Cluster
VAULT_ADDR=https://vault.wrfcoin.io
VAULT_NAMESPACE=wrfcoin/production
VAULT_AUTH_METHOD=kubernetes
VAULT_K8S_ROLE=wrfcoin-production
VAULT_MOUNT_PATH=secret
VAULT_SKIP_VERIFY=false
VAULT_MAX_RETRIES=5
VAULT_TIMEOUT=60000

# For non-K8s environments, use AppRole:
# VAULT_AUTH_METHOD=approle
# VAULT_ROLE_ID=<inject_securely>
# VAULT_SECRET_ID=<inject_securely>

# ==============================================
# BLOCKCHAIN (MAINNET)
# ==============================================

# Network Configuration
BLOCKCHAIN_NETWORK=mainnet

# RPC Endpoints (use failover configuration)
ETHEREUM_RPC_PRIMARY=https://mainnet.infura.io/v3/${INFURA_PROJECT_ID}
ETHEREUM_RPC_FALLBACK=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ETHEREUM_RPC_TERTIARY=https://ethereum.publicnode.com
POLYGON_RPC_PRIMARY=https://polygon-mainnet.infura.io/v3/${INFURA_PROJECT_ID}
POLYGON_RPC_FALLBACK=https://polygon-rpc.com
BSC_RPC_PRIMARY=https://bsc-dataseed.binance.org
AVALANCHE_RPC_PRIMARY=https://api.avax.network/ext/bc/C/rpc

# Storage Encryption (Required — node will refuse to start without this)
# Generate: openssl rand -hex 32
WRFCOIN_STORAGE_ENCRYPTION_KEY=<REPLACE_openssl_rand_hex_32>

# Wallet Configuration
WALLET_ENCRYPTION_ENABLED=true
HSM_PROVIDER=hashicorp_vault
HSM_KEY_ID=<hsm_key_identifier>

# ==============================================
# EXTERNAL SERVICES
# ==============================================

# IPFS/Pinata
PINATA_API_KEY=<inject_from_vault>
PINATA_SECRET_KEY=<inject_from_vault>

# Blockchain API Keys
INFURA_PROJECT_ID=<inject_from_vault>
ALCHEMY_API_KEY=<inject_from_vault>
ETHERSCAN_API_KEY=<inject_from_vault>
POLYGONSCAN_API_KEY=<inject_from_vault>

# ==============================================
# MONITORING
# ==============================================

# Logging
LOG_LEVEL=warn
LOG_FILE=/var/log/wrfcoin/wrfcoin-production.log

# Metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Tracing
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://jaeger-collector:14268/api/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Alerting
PAGERDUTY_SERVICE_KEY=<inject_from_vault>
SLACK_WEBHOOK_URL=<inject_from_vault>

# ==============================================
# IOT SENSORS
# ==============================================

# All IoT credentials should be managed via Vault
ACURITE_DEVICE_ID=<inject_from_vault>
ACURITE_LOCAL_IP=<inject_from_vault>

# ==============================================
# PRODUCTION SECURITY NOTES
# ==============================================
#
# 1. NEVER commit actual secrets to version control
# 2. Use Vault dynamic secrets where possible
# 3. Enable HSM for all cryptographic operations
# 4. Implement proper key rotation policies
# 5. Monitor all access to secrets via audit logs
# 6. Use Kubernetes Secrets for K8s deployments
# 7. Implement network segmentation for sensitive services
# 8. Ensure all traffic is encrypted in transit
#
# ==============================================

# Debug flags (MUST be disabled in production)
DEBUG=false
VERBOSE_LOGGING=false
USE_MOCK_DATA=false

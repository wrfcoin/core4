# WRFCoin Platform Environment Variables
# Copy this file to .env and replace placeholder values with actual secrets
# NEVER commit the actual .env file to version control!

# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY=<REPLACE_your_anthropic_api_key>       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY=<REPLACE_your_perplexity_api_key>     # Optional: Format: pplx-...
OPENAI_API_KEY=<REPLACE_your_openai_api_key>             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY=<REPLACE_your_google_api_key>             # Optional, for Google Gemini models.
MISTRAL_API_KEY=<REPLACE_your_mistral_api_key>           # Optional, for Mistral AI models.
XAI_API_KEY=<REPLACE_your_xai_api_key>                   # Optional, for xAI AI models.
GROQ_API_KEY=<REPLACE_your_groq_api_key>                 # Optional, for Groq models.
OPENROUTER_API_KEY=<REPLACE_your_openrouter_api_key>     # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY=<REPLACE_your_azure_openai_api_key> # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY=<REPLACE_your_ollama_api_key>             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY=<REPLACE_your_github_api_key>             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...
MEM0_API_KEY="REPLACE_WITH_YOUR_MEM0_API_KEY"         # Memory service API key

# Security & Authentication - CRITICAL: Generate strong random values!
JWT_SECRET="GENERATE_STRONG_RANDOM_SECRET_MIN_256_BITS"
MFA_MASTER_KEY="GENERATE_STRONG_RANDOM_KEY_FOR_MFA"
SESSION_SECRET="GENERATE_STRONG_RANDOM_SESSION_SECRET"

# Hardware Security Module (HSM) Configuration
# For production, connect a YubiKey with PIV capability or configure cloud HSM
#
# YubiKey PKCS#11 library paths:
#   Linux: /usr/lib/libykcs11.so or /usr/lib/x86_64-linux-gnu/libykcs11.so
#   macOS: /usr/local/lib/libykcs11.dylib
#   Windows: C:\Program Files\Yubico\Yubico PIV Tool\bin\libykcs11.dll
PKCS11_LIB="/usr/lib/libykcs11.so"
HSM_SLOT="0"                                           # PKCS#11 slot number (usually 0 for YubiKey)

# For development/CI without hardware HSM:
HSM_MOCK_MODE="false"                                  # Set to "true" ONLY for development/testing

# Cloud HSM alternatives (if not using YubiKey):
# HSM_ENDPOINT="https://cloudhsm.us-east-1.amazonaws.com"  # AWS CloudHSM
# HSM_KEY_ID="arn:aws:kms:region:account:key/uuid"         # AWS KMS key ARN
# HSM_REGION="us-east-1"                                    # AWS region

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/wrfcoin"
DATABASE_SSL="true"
DB_POOL_SIZE="20"

# Database Passwords
# SECURITY: Use different passwords for each environment
# POSTGRES_PASSWORD is required by docker-compose.mvp.yml — generate with:
#   openssl rand -base64 32
POSTGRES_PASSWORD="GENERATE_STRONG_DB_PASSWORD"
POSTGRES_DEV_PASSWORD="GENERATE_STRONG_DEV_DB_PASSWORD"
RABBITMQ_DEV_PASSWORD="GENERATE_STRONG_DEV_RABBITMQ_PASSWORD"
ELASTICSEARCH_PASSWORD="GENERATE_STRONG_ELASTICSEARCH_PASSWORD"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="GENERATE_STRONG_REDIS_PASSWORD"
ORACLE_REDIS_PASSWORD="GENERATE_STRONG_ORACLE_REDIS_PASSWORD"

# Monitoring & Observability
GRAFANA_ADMIN_PASSWORD="GENERATE_STRONG_ADMIN_PASSWORD"
GRAFANA_ADMIN_USER="admin"
PROMETHEUS_ADMIN_USER="prometheus"
PROMETHEUS_ADMIN_PASSWORD="GENERATE_STRONG_PROMETHEUS_PASSWORD"

# AlertManager Configuration
# Slack webhook URL for alert notifications
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# SMTP Configuration for Email Alerts
SMTP_SMARTHOST="smtp.gmail.com:587"              # SMTP server and port
SMTP_FROM="alerts@wrfcoin.com"                   # Sender email address
SMTP_USERNAME=<REPLACE_your_smtp_username>               # SMTP auth username
SMTP_PASSWORD=<REPLACE_your_smtp_app_password>           # SMTP auth password (use app password for Gmail)

# Alert Recipients
ALERT_EMAIL_TO="ops@wrfcoin.com"                 # Operations team email
SECURITY_EMAIL_TO="security@wrfcoin.com"         # Security team email (for security alerts)

# HashiCorp Vault Configuration
VAULT_ENDPOINT="http://localhost:8200"
VAULT_ROLE_ID="REPLACE_WITH_VAULT_ROLE_ID"
VAULT_SECRET_ID="REPLACE_WITH_VAULT_SECRET_ID"
# Never use dev tokens in production!

# Blockchain Configuration
BLOCKCHAIN_NODE_URL="http://localhost:8080"
BLOCKCHAIN_PRIVATE_KEY="GENERATE_OR_IMPORT_PRIVATE_KEY"
NETWORK_ID="mainnet"

# Storage Encryption (Required)
# The node will refuse to start without this key unless ALLOW_UNENCRYPTED_STORAGE=true.
# Generate a 32-byte hex key: openssl rand -hex 32
# Or use the CLI: wrfcoin-cli setup generate-storage-key
WRFCOIN_STORAGE_ENCRYPTION_KEY="GENERATE_WITH_openssl_rand_hex_32"
# Set to "true" ONLY for local development to allow unencrypted storage:
# ALLOW_UNENCRYPTED_STORAGE="true"

# Weather Station API Keys (see .env.local.example for detailed setup)
# These are typically kept in .env.local, but listed here for completeness.
# AMBIENT_WEATHER_APP_KEY=<REPLACE_your_ambient_weather_app_key>
# AMBIENT_WEATHER_API_KEY=<REPLACE_your_ambient_weather_api_key>
# AMBIENT_WEATHER_API_JON=<REPLACE_legacy_jon_alias_optional>
# AMBIENT_WEATHER_API_KEY2=<REPLACE_your_second_ambient_api_key>
# AMBIENT_APP_KEY2=<REPLACE_your_second_ambient_app_key>
# WRFCOIN_OPERATOR_TOKEN=<REPLACE_generate_with_openssl_rand_hex_32>
# WRFCOIN_ALLOW_NO_AUTH=1  # Dev only — skip auth fail-fast when no tokens are configured
# ACURITE_LOCAL_IP=<REPLACE_your_acurite_hub_ip>
# ACURITE_DEVICE_ID=<REPLACE_your_acurite_mac_address>

# Environment
NODE_ENV="production"
LOG_LEVEL="info"

# Security Headers
CORS_ORIGIN=<REPLACE_your_cors_origin>
ALLOWED_HOSTS=<REPLACE_your_allowed_hosts>

# Instructions for generating secure values:
# 
# Generate strong random secrets (Linux/Mac):
# openssl rand -base64 32
#
# Generate strong random secrets (Node.js):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# For production deployment:
# 1. Use a secrets management service (HashiCorp Vault, AWS Secrets Manager, etc.)
# 2. Rotate all secrets regularly
# 3. Never use default or weak passwords
# 4. Enable audit logging for all secret access
# 5. Use different secrets for each environment (dev, staging, prod)

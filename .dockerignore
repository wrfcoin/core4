# Node.js dependencies and build artifacts
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Rust build artifacts
**/target/
**/*.rs.bk
Cargo.lock
!Cargo.lock

# Development and IDE files
.git/
.gitignore
**/.DS_Store
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
*~

# Logs and temporary files
**/*.log
**/logs/
**/tmp/
**/temp/

# Large JSON files and reports
integration_report.json
file_manifest.json
**/*report*.json
**/*manifest*.json

# Test coverage and build outputs
**/coverage/
**/dist/
**/build/
**/.nyc_output/

# Environment and configuration (keep only what's needed)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Documentation and markdown (except essential ones)
README.md
CHANGELOG.md
LICENSE
**/*.md
!CLAUDE.md
!.taskmaster/*.md
!docs/governance/constitution.md
!docs/security/DOMAIN_TAGS.md
!docs/security/RPC_SURFACE.md

# Task Master files (not needed in containers)
.taskmaster/
.claude/

# Database files
**/*.db
**/*.sqlite
**/*.sqlite3

# Compiled binaries
**/*.exe
**/*.dll
**/*.so
**/*.dylib

# Archive files
**/*.tar
**/*.tar.gz
**/*.zip
**/*.rar

# Image files (unless specifically needed)
**/*.jpg
**/*.jpeg
**/*.png
**/*.gif
**/*.bmp
**/*.ico

# Video files
**/*.mp4
**/*.avi
**/*.mov
**/*.wmv

# Backup files
**/*.bak
**/*.backup
**/*.old

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Docker related files that shouldn't be in build context
docker-compose*.yml
Dockerfile*
.dockerignore

# Monitoring and infrastructure configs (handled via volumes)
infrastructure/
monitoring/
grafana/
prometheus/

# Security and compliance reports
SECURITY*.md
EXECUTIVE*.md
*AUDIT*.md
*REMEDIATION*.md

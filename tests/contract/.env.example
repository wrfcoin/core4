# Pact Broker credentials (required for contract tests)
PACT_BROKER_BASE_URL=http://localhost:9292
PACT_BROKER_USERNAME=admin
PACT_BROKER_PASSWORD=  # Set your Pact Broker password here — NEVER hardcode

# CI: Add PACT_BROKER_PASSWORD as a GitHub Actions repository secret
# Then reference it in workflows as: PACT_BROKER_PASSWORD: ${{ secrets.PACT_BROKER_PASSWORD }}

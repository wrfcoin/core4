    },
    {
      "path": "detect_secrets.filters.heuristic.is_potential_uuid"
    },
    {
      "path": "detect_secrets.filters.heuristic.is_prefixed_with_dollar_sign"
    },
    {
      "path": "detect_secrets.filters.heuristic.is_sequential_string"
    },
    {
      "path": "detect_secrets.filters.heuristic.is_swagger_file"
    },
    {
      "path": "detect_secrets.filters.heuristic.is_templated_secret"
    },
    {
      "path": "detect_secrets.filters.regex.should_exclude_file",
      "pattern": [
        "\\.secrets\\.baseline$",
        "\\.git/",
        "target/",
        "node_modules/",
        "\\.lock$",
        "Cargo\\.lock$",
        "package-lock\\.json$",
        "shared-protocol/tests/fixtures/wycheproof/upstream/ed25519_test\\.json$",
        "shared-protocol/tests/fixtures/wycheproof/upstream/ecdsa_secp256k1_sha256_test\\.json$",
        "shared-protocol/tests/fixtures/wycheproof/upstream/ecdsa_secp256k1_sha3_256_test\\.json$",
        "shared-protocol/tests/fixtures/wycheproof/upstream/ecdsa_secp256r1_sha256_p1363_test\\.json$",
        "^tests/integration/fixtures/determinism/expected_roots\\.json$"
      ]
    }
  ],

{
  "name": "workspace",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "main": "index.js",
  "scripts": {
    "prepare": "husky || true",
    "start:all": "echo 'frontend/ and backend/ extracted to wrfcoin/frontend and wrfcoin/backend repos'",
    "start:testnet": "concurrently \"WRFCOIN_API_HOST=127.0.0.1 WRFCOIN_API_PORT=8556 cargo run -p wrfcoin-native-chain --bin launch_api\" \"npm run dev:mvp\"",
    "onboard:station:demo": "node scripts/weather-station-onboarding.js --demo",
    "start:graphql": "echo 'backend/ extracted to wrfcoin/backend repo'",
    "dev": "turbo run dev --parallel",
    "dev:test": "NODE_ENV=test next dev -p 3001",
    "build": "turbo build",
    "build:cache": "turbo build --cache-dir=.turbo",
    "build:frontend-only": "echo 'frontend/ extracted to wrfcoin/frontend repo'",
    "start": "next start",
    "start:api": "echo 'backend/ extracted to wrfcoin/backend repo'",
    "start:test": "echo 'backend/ extracted to wrfcoin/backend repo'",
    "setup:test": "node scripts/test-setup.js setup",
    "setup:test-deps": "npm install && cd tests/e2e && npm install && npx playwright install",
    "cleanup:test": "node scripts/test-setup.js cleanup",
    "health:test": "node scripts/test-setup.js health",
    "seed:test": "node scripts/seed-test-data.js",
    "test": "turbo test",
    "test:all": "turbo test --parallel",
    "test:unit": "jest --config tests/jest.config.cjs --selectProjects unit",
    "test:integration": "jest --config tests/jest.config.cjs --selectProjects integration",
    "test:frontend": "echo 'frontend/ extracted to wrfcoin/frontend repo'",
    "test:e2e": "cd tests/e2e && playwright test",
    "test:e2e:headed": "cd tests/e2e && playwright test --headed",
    "test:e2e:debug": "cd tests/e2e && playwright test --debug",
    "test:e2e:ui": "cd tests/e2e && playwright test --ui",
    "test:e2e:wallet": "cd tests/e2e && playwright test workflows/wallet/",
    "test:e2e:defi": "cd tests/e2e && playwright test workflows/defi/",
    "test:e2e:nft": "cd tests/e2e && playwright test workflows/nft-marketplace/",
    "test:e2e:governance": "cd tests/e2e && playwright test workflows/governance/",
    "test:e2e:carbon": "cd tests/e2e && playwright test workflows/carbon-credits/",
    "test:e2e:bridge": "cd tests/e2e && playwright test workflows/cross-chain-bridge/",
    "test:e2e:weather": "cd tests/e2e && playwright test workflows/weather-data/",
    "test:e2e:computational": "cd tests/e2e && playwright test workflows/computational-jobs/",
    "test:e2e:onboarding": "cd tests/e2e && playwright test workflows/user-onboarding/",
    "test:e2e:chrome": "cd tests/e2e && playwright test --project=chromium",
    "test:e2e:firefox": "cd tests/e2e && playwright test --project=firefox",
    "test:e2e:safari": "cd tests/e2e && playwright test --project=webkit",
    "test:e2e:mobile": "cd tests/e2e && playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:e2e:smoke": "cd tests/e2e && playwright test --grep \"@smoke\"",
    "test:e2e:regression": "cd tests/e2e && playwright test --grep \"@regression\"",
    "test:e2e:report": "cd tests/e2e && playwright show-report reports/html-report",
    "test:smart-contracts": "jest --config tests/jest.config.cjs --selectProjects smart-contracts",
    "test:smart-contracts:hardhat": "npx hardhat test",
    "test:smart-contracts:coverage": "npx hardhat coverage",
    "test:multisig-security": "node test/run-multisig-security-tests.cjs",
    "test:multisig-security:coverage": "COVERAGE=true node test/run-multisig-security-tests.cjs",
    "test:multisig-security:validate": "node test/validate-multisig-setup.cjs",
    "test:templates": "jest --config tests/jest.config.cjs tests/unit/templates/",
    "test:sdk:js": "cd sdk/js && npm test",
    "test:sdk:python": "cd sdk/python && python -m pytest",
    "test:coverage": "COVERAGE=true jest --config tests/jest.enhanced.config.js --coverage && npm run test:smart-contracts:coverage",
    "test:coverage:enforce": "node tests/utils/coverage-helpers.js",
    "test:security": "jest --config tests/jest.config.cjs --selectProjects security",
    "test:performance": "cd tests && node performance/comprehensive-performance-runner.js",
    "test:performance:lighthouse": "echo 'Lighthouse CI removed - use lighthouse CLI directly'",
    "test:performance:webpagetest": "node tests/performance/webpagetest-config.js",
    "test:fuzz": "cd tests && npm run fuzz:all",
    "test:parallel": "jest --config tests/jest.enhanced.config.js --maxWorkers=75%",
    "test:parallel:ci": "jest --config tests/jest.enhanced.config.js --maxWorkers=4 --ci",
    "test:contract": "jest --config tests/jest.config.cjs --selectProjects contract",
    "test:contract:provider": "npm run test:contract -- --testNamePattern=\"Provider\"",
    "test:contract:consumer": "npm run test:contract -- --testNamePattern=\"Consumer\"",
    "test:contract:publish": "node tests/contract/scripts/publish-pacts.js",
    "test:contract:verify": "node tests/contract/scripts/verify-pacts.js",
    "test:contract:can-i-deploy": "node tests/contract/scripts/can-i-deploy.js",
    "test:contract:compatibility": "node tests/contract/scripts/compatibility-matrix.js",
    "test:contract:workflow": "node tests/contract/scripts/workflow-orchestrator.js",
    "test:contract:workflow:dry-run": "node tests/contract/scripts/workflow-orchestrator.js --dry-run",
    "pact:start-broker": "docker-compose -f tests/contract/docker-compose.pact.yml up -d",
    "pact:stop-broker": "docker-compose -f tests/contract/docker-compose.pact.yml down",
    "pact:reset-broker": "npm run pact:stop-broker && npm run pact:start-broker",
    "coverage:open": "open tests/results/coverage/lcov-report/index.html",
    "coverage:check": "COVERAGE=true jest --config tests/jest.enhanced.config.js --coverage --coverageThreshold='{\"global\":{\"branches\":80,\"functions\":80,\"lines\":80,\"statements\":80}}'",
    "coverage:clean": "rm -rf tests/results/coverage/",
    "coverage:report": "node tests/utils/test-results-processor.js",
    "test:load": "cd tests && npx artillery run load/api-load-test.yml",
    "test:watch": "jest --config tests/jest.config.cjs --watch",
    "test:topology": "echo 'backend/ extracted to wrfcoin/backend repo'",
    "test:smoke": "jest tests/smoke/smoke-tests.test.ts --no-coverage --forceExit --testTimeout=15000",
    "test:smoke:services": "SMOKE_TEST_SERVICES=true jest tests/smoke/ --no-coverage --forceExit --testTimeout=30000",
    "test:chaos": "jest tests/chaos --runInBand --forceExit --testTimeout=120000",
    "test:chaos:manual": "node scripts/manual-validation/chaos-test-runner.js",
    "test:graphql": "echo 'backend/ extracted to wrfcoin/backend repo'",
    "test:integration:verbose": "jest --config tests/jest.config.cjs --selectProjects integration --verbose",
    "test:integration:watch": "jest --config tests/jest.config.cjs --selectProjects integration --watch",
    "test:hardhat": "hardhat test",
    "compile": "turbo compile",
    "compile:templates": "hardhat compile-templates",
    "compile:all": "hardhat compile-all",
    "node": "hardhat node",
    "lint": "eslint \"**/*.{js,jsx,mjs,cjs,ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.{js,jsx,mjs,cjs,ts,tsx}\" --fix --max-warnings 0",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "lint:rust:fix": "cargo clippy --workspace --fix --all-targets --all-features -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cd blockchain-core && cargo fmt",
    "format:rust:check": "cd blockchain-core && cargo fmt -- --check",
    "security": "npm run security:solhint && npm run security:slither",
    "security:solhint": "hardhat check",
    "security:slither": "echo 'hardhat-slither removed - use slither CLI directly'",
    "security:mythx": "echo 'MythX removed - use slither or mythril CLI directly'",
    "security:comprehensive": "npm run security && npm run security:tools:all && npm run fuzz",
    "fuzz": "npm run fuzz:install && npm run fuzz:all",
    "fuzz:install": "cd fuzz-testing && npm install",
    "fuzz:all": "cd fuzz-testing && npm run fuzz:all",
    "fuzz:rest": "cd fuzz-testing && npm run fuzz:rest",
    "fuzz:websocket": "cd fuzz-testing && npm run fuzz:websocket",
    "fuzz:property": "cd fuzz-testing && npm run fuzz:property",
    "fuzz:continuous": "cd fuzz-testing && npm run fuzz:continuous",
    "fuzz:report": "cd fuzz-testing && npm run fuzz:report",
    "security:tools:install": "cd fuzz-testing/security-tools && npm install",
    "security:tools:all": "npm run security:tools:sast && npm run security:tools:dast && npm run security:tools:sca",
    "security:tools:sast": "cd fuzz-testing/security-tools && npm run security:sast",
    "security:tools:dast": "cd fuzz-testing/security-tools && npm run security:dast",
    "security:tools:sca": "cd fuzz-testing/security-tools && npm run security:sca",
    "security:tools:baseline": "cd fuzz-testing/security-tools && npm run security:baseline",
    "security:tools:nuclei": "cd fuzz-testing/security-tools && npm run security:nuclei",
    "security:tools:report": "cd fuzz-testing/security-tools && npm run security:report",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "security:gatekeeping:validate": "node scripts/validate-security-gatekeeping.js",
    "security:gatekeeping:test": "node scripts/test-security-workflows.js",
    "security:gatekeeping:full": "npm run security:gatekeeping:validate && npm run security:gatekeeping:test",
    "security:check:testnet-secrets": "bash scripts/check-testnet-secrets.sh",
    "security:check:secrets": "detect-secrets-hook --baseline .secrets.baseline $(git diff --cached --name-only)",
    "test:cross-chain-release-surface": "node scripts/check-cross-chain-release-surface.mjs --self-test",
    "canary:monitor": "node scripts/canary-health-monitor.js",
    "quality:check": "npm run lint && npm run format:check && npm run lint:rust && npm run format:rust:check",
    "quality:fix": "npm run lint:fix && npm run format && npm run lint:rust:fix && npm run format:rust",
    "quality:report": "node scripts/quality-metrics-reporter.js",
    "quality:monitor": "npm run quality:report && echo 'Quality metrics collected successfully'",
    "quality:dashboard": "node scripts/quality-dashboard-server.js",
    "quality:dashboard:start": "nohup node scripts/quality-dashboard-server.js > logs/quality-dashboard.log 2>&1 &",
    "quality:dashboard:stop": "pkill -f quality-dashboard-server.js",
    "ci:quality-gate": "node scripts/ci-cd-quality-gate.js",
    "ci:quality-gate:fast": "node scripts/ci-cd-quality-gate.js --skip-performance",
    "ci:quality-gate:full": "node scripts/ci-cd-quality-gate.js --verbose",
    "ci:parallel-tests": "npm run test:parallel:ci && npm run test:coverage:enforce",
    "quality:alert:test": "node scripts/quality-alerting-system.js test",
    "quality:alert:check": "node scripts/quality-alerting-system.js check",
    "quality:alert:monitor": "node scripts/quality-alerting-system.js monitor",
    "quality:start-monitoring": "bash scripts/start-quality-monitoring.sh",
    "quality:stop-monitoring": "bash scripts/stop-quality-monitoring.sh",
    "quality:status": "curl -s http://localhost:8090/health | jq . || echo 'Quality monitoring not running'",
    "test:rust": "cd blockchain-core && cargo test --all-features",
    "test:rust:core": "cd blockchain-core && WRFCOIN_RUN_TLS_INTEGRATION_TESTS=0 cargo test --lib --all-features",
    "test:rust:tls": "cd blockchain-core && WRFCOIN_RUN_TLS_INTEGRATION_TESTS=1 cargo test --lib network::p2p::tests::tls_tests::integration_tests::",
    "test:rust:coverage": "cd blockchain-core && cargo tarpaulin --all-features --out Xml --output-dir ../coverage",
    "type-check": "turbo type-check",
    "ci": "turbo build test lint type-check",
    "ci:cache": "turbo build test lint type-check --cache-dir=.turbo",
    "ci:fuzz": "npm run ci && npm run fuzz",
    "ci:security": "npm run ci && npm run security:comprehensive",
    "turbo:cache:clear": "turbo build --force",
    "turbo:dry-run": "turbo build --dry-run",
    "turbo:graph": "turbo build --graph",
    "turbo:validate": "node scripts/validate-turbo-setup.js",
    "turbo:benchmark": "node scripts/turbo-cache-monitor.js benchmark",
    "turbo:monitor": "node scripts/turbo-cache-monitor.js watch",
    "turbo:report": "node scripts/turbo-cache-monitor.js report",
    "todo-report": "node scripts/todo-fixme-scanner.js",
    "perf:test": "./scripts/run-performance-tests.sh",
    "perf:monitor": "./scripts/start-monitoring.sh",
    "perf:optimize": "./scripts/optimize-performance.sh",
    "perf:load": "echo 'backend/ extracted to wrfcoin/backend repo'",
    "perf:benchmark": "node consolidated-tests/performance/comprehensive-api-benchmarks.js",
    "perf:iot": "node consolidated-tests/performance/test-iot-weather-performance.js",
    "perf:enterprise": "node consolidated-tests/performance/enterprise-integration-benchmark.js",
    "perf:quick": "node consolidated-tests/performance/quick-iot-performance-test.js",
    "perf:artillery": "artillery run consolidated-tests/performance/api-load.yml",
    "rag:init": "node tools/wrf-rag/wrf-rag.js config init",
    "rag:index": "node tools/wrf-rag/wrf-rag.js index --parallel",
    "rag:index:full": "node tools/wrf-rag/wrf-rag.js index --full --parallel",
    "rag:watch": "node tools/wrf-rag/wrf-rag.js watch",
    "rag:ask": "node tools/wrf-rag/wrf-rag.js ask",
    "rag:stats": "node tools/wrf-rag/wrf-rag.js stats",
    "rag:clean": "node tools/wrf-rag/wrf-rag.js clean --older-than=7d",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:sdk": "npx typedoc --options typedoc.config.js",
    "docs:contracts": "npx hardhat docgen",
    "docs:api": "echo 'backend/ extracted to wrfcoin/backend repo — run docs:api there'",
    "docs:graphql": "node scripts/generate-graphql-docs.js",
    "docs:handbook": "bash scripts/build-mkdocs.sh",
    "docs:handbook:serve": "bash scripts/build-mkdocs.sh --serve",
    "docs:handbook:watch": "mkdocs serve --dev-addr=127.0.0.1:8001",
    "docs:style-check": "node scripts/validate-docs-style.js",
    "docs:style-check:api": "node scripts/validate-docs-style.js docs/api",
    "docs:style-check:sdk": "node scripts/validate-docs-style.js docs/sdk",
    "docs:style-check:tutorials": "node scripts/validate-docs-style.js docs/tutorials",
    "docs:serve": "node docs/documentation-server.js",
    "docs:build": "npm run docs:style-check && npm run docs:sdk && npm run docs:contracts && npm run docs:api && npm run docs:graphql && npm run docs:handbook",
    "docs:clean": "rm -rf docs/generated/*",
    "docs:watch": "concurrently \"npm run docs:serve\" \"chokidar 'sdk/**/*' 'contracts/**/*' -c 'npm run docs:build'\"",
    "docs:deploy": "npm run docs:build && npm run docs:serve",
    "dev:offline": "node scripts/environment-switcher.js offline",
    "dev:online": "node scripts/environment-switcher.js online",
    "dev:status": "node scripts/environment-switcher.js status",
    "dev:reset": "node scripts/environment-switcher.js reset",
    "dev:setup": "node scripts/dev-setup.js",
    "db:push": "node scripts/wrf-db-tool.js push",
    "db:migrate": "node scripts/wrf-db-tool.js migrate --apply",
    "db:seed": "node scripts/wrf-db-tool.js seed --all",
    "db:status": "node scripts/wrf-db-tool.js status",
    "db:setup": "node scripts/wrf-db-tool.js push && node scripts/wrf-db-tool.js seed --all",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "health": "curl -sf http://localhost:4001/health && echo ' API OK' || echo 'API not responding'",
    "dev:mvp": "echo 'frontend/ and backend/ extracted to wrfcoin/frontend and wrfcoin/backend repos'",
    "build:mvp": "echo 'frontend/ extracted to wrfcoin/frontend repo'",
    "docker:mvp": "docker-compose -f docker-compose.mvp.yml up",
    "docker:mvp:down": "docker-compose -f docker-compose.mvp.yml down",
    "test:mvp": "npm run test:e2e:wallet && npm run test:e2e:weather && npm run test:e2e:governance && npm run test:e2e:nft",
    "pre-deploy-security-check": "npm audit --audit-level=high && echo 'Security check passed'"
  },

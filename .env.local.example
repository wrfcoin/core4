# Local weather station API keys (not committed — copy to .env.local)
# Get your keys from: https://ambientweather.net/account
#
# To get Ambient Weather keys:
#   1. Create account at ambientweather.net
#   2. Go to Account > API Keys
#   3. Create Application Key (developer) and API Key (user)

# Primary Ambient Weather credentials
AMBIENT_WEATHER_APP_KEY=your_ambient_weather_app_key_here
AMBIENT_WEATHER_API_KEY=your_ambient_weather_api_key_here
# Legacy alias still accepted by fetch-ambient-weather.cjs
AMBIENT_WEATHER_API_JON=your_ambient_weather_api_key_here

# Secondary Ambient Weather credentials (optional fallback)
AMBIENT_WEATHER_API_KEY2=your_second_ambient_weather_api_key_here
AMBIENT_APP_KEY2=your_second_ambient_app_key_here

# Operator token — generate via: openssl rand -hex 32
WRFCOIN_OPERATOR_TOKEN=generate_with_openssl_rand_hex_32

# Dev only — set to 1 to skip auth fail-fast when no tokens are configured.
# The node will start WITHOUT authentication. NEVER use in production.
# WRFCOIN_ALLOW_NO_AUTH=1

# AcuRite local station (optional — only if you have an AcuRite hub)
ACURITE_LOCAL_IP=192.168.x.x
ACURITE_DEVICE_ID=00:00:00:00:00:00

# NWS reference station for accuracy comparison (default: KDLH — Duluth International Airport)
# NWS_STATION_ID=KDLH

# WRFCoin MCP Server Configuration

# API Authentication (required for authenticated endpoints)
WRFCOIN_API_KEY=your-api-key-here
# WRFCOIN_JWT_TOKEN=optional-bearer-token

# Service URLs (defaults shown - override for remote/custom deployments)
# WRFCOIN_API_HOST=http://localhost:4001
# WRFCOIN_WALLET_HOST=http://localhost:4000
# WRFCOIN_WEATHER_HOST=http://localhost:8080
# WRFCOIN_GOVERNANCE_HOST=http://localhost:8000

# Request timeout in milliseconds (default: 10000)
# WRFCOIN_REQUEST_TIMEOUT=10000

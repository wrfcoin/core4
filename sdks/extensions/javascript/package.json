{
  "name": "@wrfcoin/sdk-extensions",
  "version": "2.0.0",
  "description": "WRFCoin SDK Extensions - Custom functionality not covered by auto-generated APIs",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compute-receipt": {
      "types": "./dist/compute-receipt/index.d.ts",
      "import": "./dist/compute-receipt/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint \"**/*.ts\"",
    "artifact:smoke": "npm run build && node scripts/installed-artifact-smoke.mjs"
  },
  "keywords": [
    "wrfcoin",
    "blockchain",
    "weather",
    "iot",
    "extensions"
  ],
  "author": "WRFCoin Team",
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.4.0",
    "axios": "^1.20.0",
    "ethers": "^6.17.0",
    "graphql": "^16.14.0",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.9.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
